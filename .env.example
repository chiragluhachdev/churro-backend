PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/churro-academy
JWT_SECRET=replace-with-a-64-char-hex-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Optional: upgrades the chat widget from keyword matching to Llama 3.3 70B.
# Free key from https://console.groq.com — leave blank and the bot still works.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: sends the real "you're enrolled" email (course details + video
# links) via Brevo once an order is paid. Key from Brevo > SMTP & API >
# API Keys — leave blank and the email is just logged to the server console
# instead of sent (checkout still works end to end; nothing goes to the
# buyer until this is set).
BREVO_API_KEY=
# "Name <address>". Must be a sender verified in the Brevo account (Senders,
# Domains & Dedicated IPs) — Brevo has no sandbox sender, so an unverified
# address fails every send (visible as emailError on the order in the admin
# billing screen).
EMAIL_FROM=Churro Academy <no-reply@yourdomain.com>
# The deployed frontend — used to build links (e.g. invoices) inside emails.
# CORS_ORIGIN can be "*", which can't do this job, so it's a separate setting.
APP_URL=http://localhost:3000
